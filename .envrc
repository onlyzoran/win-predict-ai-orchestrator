# Secret-free: values come from Infisical at runtime after `infisical login`.
# Override env: INFISICAL_ENV=prod direnv allow
# Do not put raw secret values in this file.

export INFISICAL_DOMAIN="${INFISICAL_DOMAIN:-https://secrets.win-predict-ai.com}"

if ! command -v infisical >/dev/null 2>&1; then
  echo "direnv: install Infisical CLI (brew install infisical/get-cli/infisical)" >&2
  return 0 2>/dev/null || exit 0
fi

ENV_SLUG="${INFISICAL_ENV:-dev}"
if ! eval "$(infisical export --env="$ENV_SLUG" --path="/" --format=dotenv-export --silent 2>/dev/null)"; then
  echo "direnv: Infisical export failed (run: infisical login --domain https://secrets.win-predict-ai.com)" >&2
fi

# Optional local overrides (gitignored). Prefer Infisical.
[[ -f .envrc.local ]] && source_env .envrc.local
