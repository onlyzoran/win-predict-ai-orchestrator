[Unit]
Description=gift-sales Next.js (http://202.71.15.138/gift-sales/)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cursor-worker
Group=cursor-worker
WorkingDirectory=/var/www/gift-sales
EnvironmentFile=-/etc/cursor-worker.env
Environment=HOME=/opt/cursor-workers
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=PORT=3002
Environment=HOSTNAME=127.0.0.1
Environment=GIFT_SALES_DB=/var/lib/gift-sales/data/quotes.db
NoNewPrivileges=true
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
