# Personal user API key (Dashboard → API Keys). Not a service-account / team Admin key.
# Same Cursor user as the GitHub secret CURSOR_API_KEY.
CURSOR_API_KEY=cursor_...

# PAT with repo + project + read:packages on all six win-predict repos.
# Watch and workers use it as GH_TOKEN; read:packages needed to bump prereleases into app/admin.
GITHUB_PAT=ghp_...

# Same chat as the GitHub Action secrets. Without these, board-watch is silent in Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Default: $HOME/data/inventory.json → /opt/cursor-workers/data/inventory.json on the VPS.
# ORCHESTRATOR_INVENTORY=/opt/cursor-workers/data/inventory.json

# Public copy for the status UI (http://202.71.15.138/ops/). Created by ops/install-status.sh.
# ORCHESTRATOR_STATUS_DIR=/var/www/orchestrator-status

# Deprecated — board id lives in orchestrator/products/registry.json (win-predict-ai.board).
# If set to a deleted project (e.g. old #4 PVT_kwHOAom_KM4Bg7oB), board-watch fails; remove the line.
# ORCHESTRATOR_PROJECT_ID=PVT_kwHOAom_KM4BgVLq
