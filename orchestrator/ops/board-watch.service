[Unit]
Description=win-predict board watch (In Progress + Ready to Release)
After=network-online.target cursor-worker.service
Wants=network-online.target

[Service]
Type=oneshot
User=cursor-worker
Group=cursor-worker
WorkingDirectory=/opt/cursor-workers/win-predict-ai-orchestrator
EnvironmentFile=-/etc/cursor-worker.env
Environment=HOME=/opt/cursor-workers
Environment=PATH=/opt/cursor-workers/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CURSOR_MACHINE_NAME=win-predict-vps
Environment=ORCHESTRATOR_STATUS_DIR=/var/www/orchestrator-status
NoNewPrivileges=true
TimeoutStartSec=120min
ExecStart=/opt/cursor-workers/win-predict-ai-orchestrator/orchestrator/ops/board-watch.sh
