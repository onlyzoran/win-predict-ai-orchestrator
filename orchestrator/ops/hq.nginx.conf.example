# Nginx vhost for Win Predict HQ pitch page.
# Install on the VPS as:
#   /etc/nginx/sites-available/hq.win-predict-ai.com
# then: ln -s ... sites-enabled && nginx -t && systemctl reload nginx
#
# DNS: A/AAAA for hq.win-predict-ai.com → this VPS
# TLS after HTTP works:
#   certbot --nginx -d hq.win-predict-ai.com
# (certbot adds the 443 server block and certificates)
#
# Не ставь default_server на 443. Иначе https://<ip>/ любой путь отдаёт эту SPA
# (try_files → index.html) — demo gift-sales выглядит как Win Predict HQ.
# Default TLS для IP: gift-sales-ip-ssl (install-gift-sales.sh).

server {
    listen 80;
    listen [::]:80;
    server_name hq.win-predict-ai.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    root /var/www/orchestrator-hq;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "public, max-age=300";
    }
}
