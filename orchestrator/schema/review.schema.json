{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/onlyzoran/win-predict-ai-orchestrator/orchestrator/schema/review.schema.json",
  "title": "OrchestratorReview",
  "description": "Вердикт local-ревьюера по child PR.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "changes", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Коротко на русском для комментария к child issue."
    },
    "findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
