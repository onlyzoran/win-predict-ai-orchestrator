# Copy to .env on the VPS and fill in. NEVER commit a real .env.
# Generate keys on your laptop (not only on the VPS), then store copies
# in a password manager / offline safe — not solely on this server.

# --- Master keys (critical) ---
# ENCRYPTION_KEY: openssl rand -hex 16
# Without this key, a Postgres backup cannot be decrypted.
ENCRYPTION_KEY=replace_with_openssl_rand_hex_16

# AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=replace_with_openssl_rand_base64_32

# --- Public URL (must match nginx + DNS + HTTPS) ---
SITE_URL=https://secrets.win-predict-ai.com

# --- Postgres (docker service name "db") ---
POSTGRES_USER=infisical
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=infisical
DB_CONNECTION_URI=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- Redis (docker service name "redis") ---
REDIS_URL=redis://redis:6379

# --- Optional SMTP (Infisical invites / password reset; later also ops alerts) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM_ADDRESS=noreply@example.com
# SMTP_FROM_NAME=Infisical
# SMTP_USERNAME=
# SMTP_PASSWORD=
