# Nginx vhost for Infisical. Install on the VPS as e.g.
#   /etc/nginx/sites-available/secrets.win-predict-ai.com
# then: ln -s ... sites-enabled && nginx -t && systemctl reload nginx
#
# Obtain TLS with certbot after DNS A/AAAA points at this VPS:
#   certbot --nginx -d secrets.win-predict-ai.com

server {
    listen 80;
    listen [::]:80;
    server_name secrets.win-predict-ai.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name secrets.win-predict-ai.com;

    # certbot will fill these (or set manually):
    # ssl_certificate     /etc/letsencrypt/live/secrets.win-predict-ai.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/secrets.win-predict-ai.com/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
