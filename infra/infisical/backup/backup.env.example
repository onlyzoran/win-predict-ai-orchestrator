# Copy to /etc/infisical/backup.env on the VPS (chmod 600). Do not commit real values.
#
# Cloudflare R2 example:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_BUCKET=win-predict-infisical
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_DEFAULT_REGION=auto
#
# Backblaze B2 / AWS / Yandex: set endpoint + keys per their docs.

S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=win-predict-infisical
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_DEFAULT_REGION=auto

BACKUP_LOCAL_DIR=/var/backups/infisical
BACKUP_KEEP_LOCAL=3
